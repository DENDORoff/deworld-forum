# ──────────────────────────────────────────────────────────────────────────
# DEWORLD Forum — пример конфигурации окружения
# Скопируйте в .env и заполните значения. НИКОГДА не коммитьте .env в Git.
# ──────────────────────────────────────────────────────────────────────────

# Подключение к PostgreSQL (Neon для production)
# Neon: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deworld"

# Секрет для подписи JWT-сессий Auth.js. Сгенерировать: npx auth secret
AUTH_SECRET=""

# Базовый URL сайта (production). Для локальной разработки можно оставить пустым.
AUTH_URL="http://localhost:3000"
# Публичный URL канонического адреса (sitemap/OG). Обычно совпадает с AUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── OAuth-провайдеры (включайте, когда заполните ключи) ────────────────────
# Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub — https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Discord — https://discord.com/developers/applications
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ВКонтакте (oauth.vk.com / VK ID) — https://vk.com/apps?act=manage
AUTH_VK_ID=""
AUTH_VK_SECRET=""

# ── Привязка Minecraft / LimboAuth (необязательно) ─────────────────────────
# Отдельный пул подключений к БД LimboAuth для входа по ник+паролю.
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
LIMBOAUTH_DATABASE_URL=""
# Таблица и колонки LimboAuth (значения по умолчанию указаны справа)
LIMBOAUTH_TABLE="limboauth"
LIMBOAUTH_USERNAME_COLUMN="name"
LIMBOAUTH_PASSWORD_COLUMN="password"

# ── Интеграции сайта ───────────────────────────────────────────────────────
# Хост и порт Minecraft-сервера для виджета статуса
MINECRAFT_SERVER_HOST="mc.de-world.net"
MINECRAFT_SERVER_PORT="25565"

# Ссылка-приглашение в Discord и ID сервера (для виджета)
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/deworld"
NEXT_PUBLIC_DISCORD_GUILD_ID=""

# ID плейлиста YouTube канала (для карусели видео)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=""
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=""

# ── Ограничитель частоты запросов ──────────────────────────────────────────
RATE_LIMIT_ENABLED="true"

# ── Cloudflare Turnstile (капча на входе/регистрации) ──────────────────────
# Тестовые ключи (always pass) в коде — сайт работает из коробки.
# В production ОБЯЗАТЕЛЬНО задайте настоящие ключи:
# https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Почта (уведомления + восстановление пароля) ────────────────────────────
# Вариант А (одной строкой): SMTP_URL="smtps://user:pass@smtp.yandex.ru:465"
# Вариант Б (по полям):
# SMTP_HOST="smtp.yandex.ru"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="noreply@de-world.net"
# SMTP_PASS=""
MAIL_FROM="DEWORLD <noreply@de-world.net>"
# Примеры провайдеров: Yandex 360 (smtp.yandex.ru:465), Mail.ru (smtp.mail.ru:465),
# Resend SMTP (smtp.resend.com:465, user "resend", pass = API key),
# Mailgun (smtp.mailgun.org:465), SMTP2GO (mail.smtp2go.com:2525)

# ── Локальное окружение ────────────────────────────────────────────────────
NODE_ENV="development"
